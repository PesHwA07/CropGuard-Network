# =============================================================================
# CropGuard Network — Environment Variables
# Copy to .env and fill in values before running.
# =============================================================================

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cropguard
DB_USER=postgres
DB_PASSWORD=cropguard_dev

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/cropguard

# --- Kafka ---
KAFKA_BROKER=localhost:9092

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- YOLOv8 Model Paths (one per crop, populated after training) ---
YOLO_MODEL_DIR=./vision_training/runs

# --- Azure (only needed for deployment, leave blank for local dev) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=crop-images

# --- Groq LLM (RAG generation) ---
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_LIGHT=llama-3.1-8b-instant

# --- ChromaDB (RAG vector store) ---
VECTOR_DB_URL=http://localhost:8000

# --- JWT Auth ---
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440
